NODE_ENV=development
PORT=4100

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=
POSTGRES_PASSWORD=
# Postgres — on Render set DATABASE_URL or POSTGRES_DB (required; avoids pool → …/undefined)
POSTGRES_DB=serveaso1
# DATABASE_URL=postgresql://user:pass@host:5432/serveaso1

# Required on Render when quotes use coupons — public URL of the coupons service
# Example: https://your-coupons-service.onrender.com
COUPONS_SERVICE_URL=http://localhost:3002

# Platform settings (cancellation policy, provider reminders) — utils service
UTILS_SERVICE_URL=http://localhost:3030

# Overdue start reminders for providers (in-app + optional push/SMS)
OVERDUE_START_REMINDER_ENABLED=true
# ADMIN_PUSH_SECRET on utils must match for FCM push from payments scheduler

# Local: mongodb://127.0.0.1:27017 — or copy from private .env.development (not committed)
MONGO_URI=mongodb://127.0.0.1:27017

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_KEY=
RAZORPAY_SECRET=
# Razorpay Dashboard → Webhooks → signing secret for POST /api/v2/createEngagements/webhook
RAZORPAY_WEBHOOK_SECRET=
# Dev only: set true to skip webhook HMAC (never use in production)
# SKIP_RAZORPAY_WEBHOOK_VERIFY=false
